# ---------------------------------------------------------------------------
# Mauritius Compta - example environment file. Copy to .env and fill in.
# NEVER commit real secrets. Values below are placeholders.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:5173

# PostgreSQL (production / VPS)
# In local development you may use the docker-compose service.
DATABASE_URL=postgresql://mc_user:change_me_in_env@localhost:5432/mauritius_compta
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Session
SESSION_COOKIE_NAME=mc_session
SESSION_TTL_HOURS=168
# Set to true behind HTTPS (production MUST be true)
COOKIE_SECURE=false

# Authentication tuning
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=10
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_WINDOW_MINUTES=15
ALLOW_REGISTRATION=true
# Expired sessions and old login attempts are pruned on successful login.
SESSION_PURGE_ON_LOGIN=true

# Demo seeding is always refused when NODE_ENV=production, unless this is
# explicitly set to true on a dedicated demonstration instance.
# ALLOW_DEMO_SEED=false

# Storage for supporting documents (justificatifs)
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760

# Locale
DEFAULT_LOCALE=fr

# ---------------------------------------------------------------------------
# Mauritius AI Engine (optional)
#
# The AI engine is OFF per cabinet until an administrator enables it. No
# provider key is ever stored here: each cabinet enters its own key in the
# interface and the server encrypts it with the key below.
#
# AI_ENCRYPTION_KEY must be 32 random bytes, hex (64 chars) or base64.
# Generate one with:  openssl rand -hex 32
# Without it the API refuses to store a key (503 AI_ENCRYPTION_NOT_CONFIGURED).
# AI_ENCRYPTION_KEY=
AI_ENCRYPTION_KEY_VERSION=v1
# Previous keys kept for decryption during a rotation: "v0:<key>"
# AI_ENCRYPTION_PREVIOUS_KEYS=
# AI_CATALOGUE_PATH=./apps/api/config/ai-providers.json
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_INPUT_CHARS=2000
# The fictional provider is only for demonstrations and tests.
# AI_ALLOW_SIMULATED=false
# Allow a private base URL (self-hosted model gateway). Off by default (SSRF).
# AI_ALLOW_PRIVATE_BASE_URL=false
