# ---------------------------------------------------------------------------
# Mauritius Compta - example environment file. Copy to .env and fill in.
# NEVER commit real secrets. Values below are placeholders.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:5173

# PostgreSQL (production / VPS)
# In local development you may use the docker-compose service.
DATABASE_URL=postgresql://mc_user:change_me_in_env@localhost:5432/mauritius_compta
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Session
SESSION_COOKIE_NAME=mc_session
SESSION_TTL_HOURS=168
# Set to true behind HTTPS (production MUST be true)
COOKIE_SECURE=false

# Authentication tuning
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=10
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_WINDOW_MINUTES=15
ALLOW_REGISTRATION=true
# Expired sessions and old login attempts are pruned on successful login.
SESSION_PURGE_ON_LOGIN=true

# Demo seeding is always refused when NODE_ENV=production, unless this is
# explicitly set to true on a dedicated demonstration instance.
# ALLOW_DEMO_SEED=false

# Storage for supporting documents (justificatifs)
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760

# Locale
DEFAULT_LOCALE=fr
