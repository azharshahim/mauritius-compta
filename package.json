{
  "name": "mauritius-compta",
  "version": "0.1.0",
  "private": true,
  "description": "Mauritius Compta - bilingue FR/EN accounting software for Mauritian businesses",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @mc/api",
    "dev:web": "npm run dev -w @mc/web",
    "build": "npm run build -w @mc/web && npm run build -w @mc/api",
    "start": "npm run start -w @mc/api",
    "typecheck": "npm run typecheck -w @mc/api && npm run typecheck -w @mc/web",
    "test": "npm run test -w @mc/api",
    "db:migrate": "npm run db:migrate -w @mc/api",
    "db:seed": "npm run db:seed -w @mc/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}